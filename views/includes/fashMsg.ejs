<% if(successMsg && successMsg.length) {%>
<div
  class="alert alert-success offset-3 col-6 alert-dismissible fade show"
  role="alert"
>
  <strong><%=successMsg%></strong>
  <button
    type="button"
    class="btn-close"
    data-bs-dismiss="alert"
    aria-label="Close"
  ></button>
</div>
<%}%> <% if(errorMsg && errorMsg.length) {%>
<div
  class="alert alert-danger offset-3 col-6 alert-dismissible fade show"
  role="alert"
>
  <strong><%=errorMsg%></strong>
  <button
    type="button"
    class="btn-close"
    data-bs-dismiss="alert"
    aria-label="Close"
  ></button>
</div>
<%}%>
